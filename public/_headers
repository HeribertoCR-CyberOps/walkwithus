/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # no-transform: stops the edge injecting analytics/bot scripts into our HTML (privacy promise: no third-party requests)
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/c.html
  ! Cache-Control
  Cache-Control: no-store, no-transform
/c
  ! Cache-Control
  Cache-Control: no-store, no-transform
/v.html
  ! Cache-Control
  Cache-Control: no-store, no-transform
/v
  ! Cache-Control
  Cache-Control: no-store, no-transform
