// Walk With Us — Cloudflare Workers + D1 + static assets. $0 on the free tier.
// Secrets (never in this file):  wrangler secret put DATA_KEY   (base64, 32 random bytes — AES-256-GCM at rest)
//                                wrangler secret put HMAC_KEY   (base64, 32 random bytes — keyed hashes for dedupe/rate limits)
//                                wrangler secret put TURNSTILE_SECRET   (optional; enables bot check on public forms)
{
  "name": "walkwithus",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "404-page" },
  "d1_databases": [
    { "binding": "DB", "database_name": "walkwithus", "database_id": "9d6c1790-1c0d-4b5a-8fc6-80fb907b6f11", "migrations_dir": "migrations" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "walk.savvysolutionpros.com", "custom_domain": true }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "APP_NAME": "Walk With Us",
    "ACCESS_TEAM_DOMAIN": "savvysolutionpros.cloudflareaccess.com",
    "ACCESS_AUD": "d543df865545703a71f087e1352c0dec67021ee6e0d1c1ad8ea63f27731086ae",
    "RETENTION_HOURS": "72",
    "TURNSTILE_SITEKEY": ""
  }
}
