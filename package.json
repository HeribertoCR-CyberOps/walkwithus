{
  "name": "walkwithus",
  "version": "1.1.4",
  "private": true,
  "description": "Walk With Us — free, privacy-first safe-passage coordination for community organizations. Coordinates adults; never tracks children.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply walkwithus --local",
    "db:migrate:remote": "wrangler d1 migrations apply walkwithus --remote",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/e2e.test.mjs",
    "test:ui": "node test/ui-smoke.mjs",
    "deploy:ssp": "wrangler deploy -c wrangler.ssp.jsonc",
    "db:migrate:ssp": "wrangler d1 migrations apply walkwithus --remote -c wrangler.ssp.jsonc",
    "monitor": "node scripts/monitor.mjs",
    "test:property": "node --test test/property.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "fast-check": "4.10.2",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeribertoCR-CyberOps/walkwithus.git"
  },
  "homepage": "https://walk.savvysolutionpros.com",
  "bugs": {
    "url": "https://github.com/HeribertoCR-CyberOps/walkwithus/issues"
  }
}
